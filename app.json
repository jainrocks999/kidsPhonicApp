{
  "expo": {
    "name": "Phonics Flashcards for Kids",
    "slug": "phonics-flashcards-kids",
    "scheme": "phonicsflashcards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8E1",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.phonicsflashcards.kids"
    },
    "android": {
      "package": "com.phonicsflashcards.kids",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0EC19F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.ACCESS_ADSERVICES_TOPICS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Phonics Flashcards for Kids to record your child saying words so they can listen back.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0EC19F",
          "android": {
            "image": "./assets/splash-icon-android.png"
          }
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-video",
      "expo-iap",
      "react-native-google-mobile-ads"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyUrl": "",
      "termsUrl": "",
      "supportEmail": "",
      "eas": {
        "projectId": "1391f053-53ce-409f-b91c-7938a56f7939"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1391f053-53ce-409f-b91c-7938a56f7939",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "assetPatternsToBeBundled": [
        "assets/**/*.png"
      ]
    },
    "owner": "forebearpros"
  }
}
